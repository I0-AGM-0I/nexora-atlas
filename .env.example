# NEXORA ATLAS Environment Configuration Template
# Copy this file to .env for local overrides. Never commit .env with real secrets.

# Application Environment (development | staging | production)
ENVIRONMENT=development

# Service Identity
SERVICE_NAME=nexora-atlas-api
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Demo Mode (true enables deterministic synthetic SaaS spend without cloud connection)
DEMO_MODE=true

# Database Strategy:
# 1. PostgreSQL (Canonical Production / Docker Compose):
#    DATABASE_URL=postgresql+asyncpg://atlas_user:atlas_password@localhost:5432/atlas_db
# 2. SQLite (Local Development / Zero-Docker Fallback):
#    DATABASE_URL=sqlite+aiosqlite:///./atlas_dev.db
DATABASE_URL=sqlite+aiosqlite:///./atlas_dev.db

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Server Bindings
HOST=0.0.0.0
PORT=8000

# AWS Credentials (Optional, Read-Only, not needed for Demo Mode)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_ROLE_ARN=
